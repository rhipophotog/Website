# Copy to .env.local. For local dev, `npm run env:local` fills the Supabase values
# from `npx supabase status`. Never commit real values.

# development | test | production. Real email/SMS is only ever sent when this is production.
APP_ENV=development
STUDIO_TIME_ZONE=America/Los_Angeles

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by `npm run owner:invite`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in: set to true once the Google OAuth client is configured in Supabase
# (locally: SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / _SECRET and enabled = true in supabase/config.toml).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Tests (Vitest DB suite). Any Postgres 15+ superuser URL; the Supabase local DB works.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Lead capture (milestone 4) ---
# SUPABASE_SERVICE_ROLE_KEY above is also required by the public inquiry form and lead webhooks.
# Cloudflare Turnstile spam protection. Leave blank to use Cloudflare's always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Any long random string; used to hash visitor IPs for rate limiting.
LEAD_IP_SALT=
# Meta Lead Ads webhook (/api/webhooks/meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# Google Ads lead form webhook (/api/webhooks/google-ads): the "Key" you enter in Google Ads
GOOGLE_ADS_WEBHOOK_KEY=

# --- Email (milestone 5): Resend ---
RESEND_API_KEY=
# Signing secret of the Resend webhook pointing at /api/webhooks/resend (whsec_...)
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="RHIPO Photography <hello@yourdomain.com>"
# Replies: an address on a Resend receiving domain threads them into the app (e.g. replies@reply.yourdomain.com)
EMAIL_REPLY_TO=
# The owner's inbox for copies of client replies and new-lead alerts
OWNER_NOTIFY_EMAIL=
UNSUBSCRIBE_SECRET=
APP_URL=

# --- Calendar (milestone 7) ---
# Google Cloud OAuth client (Web application); redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Encrypts the Google tokens stored in the database. Don't change it later
# (you'd have to reconnect Google Calendar).
TOKEN_ENCRYPTION_KEY=
